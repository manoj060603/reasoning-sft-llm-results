__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv*/
venv/

# Local credentials and environment overrides
.env
.env.*
!.env.example
*.pem
*.key

# Regenerable runtime state
runs/
eval/outputs/
eval/completions/
*.partial.json
slurm-*.out

# GitHub rejects files larger than 100 MiB. Their paths, sizes, and hashes are
# recorded in LARGE_ARTIFACTS.md; smaller configs and provenance stay tracked.
*.safetensors
artifacts/datasets-final-8k/advanced.json

# Per-sample generation batches are bulky and make ordinary Git clones
# impractical. Metrics, comparisons, manifests, diagnostics, and their content
# inventory remain tracked.
results/**/batch_*.json

# Packaged deliverables are generated from the tracked tree.
*.zip

# Resumable training-only preparation contains large raw generations/prefixes.
artifacts/demonstration-response/
artifacts/datasets-demonstration-response-15k/advanced.json

# Full-length candidate exports retain original large source responses.
artifacts/datasets-full-length-15k/advanced.json

